{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scientific-human-model.local/schemas/adapter-spec.v0.1.json",
  "title": "AdapterSpec v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_id",
    "adapter_version",
    "status",
    "source_observation_ref",
    "target_model_ref",
    "mappings",
    "unmapped_source",
    "unmapped_target",
    "invariants",
    "failure_behavior"
  ],
  "properties": {
    "schema_version": { "const": "adapter-spec.v0.1" },
    "adapter_id": { "type": "string", "minLength": 1 },
    "adapter_version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["definition_only", "implemented", "validated", "blocked", "rejected"] },
    "source_observation_ref": { "type": "string", "minLength": 1 },
    "target_model_ref": { "type": "string", "minLength": 1 },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mapping_id", "source_channel_id", "target_block_ids", "transform_kind", "status", "required_evidence", "loss_fields"],
        "properties": {
          "mapping_id": { "type": "string", "minLength": 1 },
          "source_channel_id": { "type": "string", "minLength": 1 },
          "target_block_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "transform_kind": { "enum": ["identity", "unit_scale", "permutation", "linear", "nonlinear", "unresolved"] },
          "status": { "enum": ["confirmed", "candidate", "unresolved", "rejected"] },
          "required_evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "loss_fields": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "unmapped_source": { "type": "array", "items": { "type": "string" } },
    "unmapped_target": { "type": "array", "items": { "type": "string" } },
    "invariants": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "failure_behavior": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
