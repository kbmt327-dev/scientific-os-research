{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scientific-human-model.local/schemas/adapter-spec.v0.2.json",
  "title": "AdapterSpec v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_id",
    "adapter_version",
    "status",
    "source_observation_ref",
    "target_model_ref",
    "mappings",
    "unmapped_source",
    "unmapped_target",
    "source_consistency_handling",
    "invariants",
    "failure_behavior"
  ],
  "properties": {
    "schema_version": { "const": "adapter-spec.v0.2" },
    "adapter_id": { "type": "string", "minLength": 1 },
    "adapter_version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["definition_only", "implemented", "validated", "blocked", "rejected"] },
    "source_observation_ref": { "type": "string", "minLength": 1 },
    "target_model_ref": { "type": "string", "minLength": 1 },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mapping_id",
          "source_channel_id",
          "source_coordinate_space_id",
          "target_block_ids",
          "target_frame_ids",
          "transform_kind",
          "status",
          "required_evidence",
          "loss_fields"
        ],
        "properties": {
          "mapping_id": { "type": "string", "minLength": 1 },
          "source_channel_id": { "type": "string", "minLength": 1 },
          "source_coordinate_space_id": { "type": "string", "minLength": 1 },
          "target_block_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "target_frame_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "transform_kind": { "enum": ["identity", "unit_scale", "permutation", "linear", "nonlinear", "unresolved"] },
          "status": { "enum": ["confirmed", "candidate", "unresolved", "rejected"] },
          "required_evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "loss_fields": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "unmapped_source": { "type": "array", "items": { "type": "string" } },
    "unmapped_target": { "type": "array", "items": { "type": "string" } },
    "source_consistency_handling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warning_ids_reviewed", "unresolved_warning_behavior"],
      "properties": {
        "warning_ids_reviewed": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "unresolved_warning_behavior": { "enum": ["fail_closed", "respect_observation_behavior"] }
      }
    },
    "invariants": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "failure_behavior": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
