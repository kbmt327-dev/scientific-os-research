{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scientific-human-model.local/schemas/observation-spec.v0.1.json",
  "title": "ObservationSpec v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "dataset",
    "subject",
    "trial",
    "timebase",
    "channels",
    "processing_passes",
    "rights",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "observation-spec.v0.1" },
    "observation_id": { "type": "string", "minLength": 1 },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "source_uri", "local_artifact_status"],
      "properties": {
        "dataset_id": { "type": "string", "minLength": 1 },
        "source_uri": { "type": "string", "minLength": 1 },
        "local_artifact_status": { "enum": ["available", "not_downloaded", "restricted", "missing"] },
        "content_hash": { "type": ["string", "null"] }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "identity_status", "population_tags"],
      "properties": {
        "subject_id": { "type": "string", "minLength": 1 },
        "identity_status": { "enum": ["confirmed", "pseudonymous", "unknown"] },
        "population_tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trial_id", "task", "condition", "condition_status"],
      "properties": {
        "trial_id": { "type": "string", "minLength": 1 },
        "task": { "type": "string", "minLength": 1 },
        "condition": { "type": "string", "minLength": 1 },
        "condition_status": { "enum": ["confirmed", "candidate", "unknown"] }
      }
    },
    "timebase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_rate_hz", "sample_rate_status", "time_origin", "synchronization_status"],
      "properties": {
        "sample_rate_hz": {
          "anyOf": [
            { "type": "number", "exclusiveMinimum": 0 },
            { "type": "null" }
          ]
        },
        "sample_rate_status": { "enum": ["confirmed", "estimated", "unknown"] },
        "time_origin": { "type": "string", "minLength": 1 },
        "synchronization_status": { "enum": ["confirmed", "estimated", "unknown"] }
      }
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel_id", "quantity_kind", "unit", "frame_id", "evidence_class", "processing_pass_id", "missingness", "leakage_tags"],
        "properties": {
          "channel_id": { "type": "string", "minLength": 1 },
          "quantity_kind": { "type": "string", "minLength": 1 },
          "unit": { "type": "string", "minLength": 1 },
          "frame_id": { "type": "string", "minLength": 1 },
          "evidence_class": { "enum": ["measured", "derived", "model_derived", "synthetic", "unknown"] },
          "processing_pass_id": { "type": "string", "minLength": 1 },
          "missingness": { "enum": ["none", "flagged", "unknown"] },
          "leakage_tags": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    },
    "processing_passes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["processing_pass_id", "inputs", "operations", "uses_target_measurement"],
        "properties": {
          "processing_pass_id": { "type": "string", "minLength": 1 },
          "inputs": { "type": "array", "items": { "type": "string" } },
          "operations": { "type": "array", "items": { "type": "string" } },
          "uses_target_measurement": { "type": "boolean" }
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license_status", "license", "redistribution"],
      "properties": {
        "license_status": { "enum": ["confirmed", "unknown", "restricted"] },
        "license": { "type": ["string", "null"] },
        "redistribution": { "enum": ["allowed", "not_allowed", "unknown"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_refs", "available_at", "recorded_at"],
      "properties": {
        "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "available_at": { "type": ["string", "null"], "format": "date-time" },
        "recorded_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
